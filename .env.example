# ============================================================
# REAL IEEE-CIS TRAINING (required for model generation)
# ============================================================
RANDOM_STATE=42
MODEL_N_ESTIMATORS=100
LOGISTIC_MAX_ITER=20
TRAIN_FRACTION=0.70
VALIDATION_FRACTION=0.15
TEST_FRACTION=0.15
RAW_DATA_DIR=data/raw
MODEL_DIR=models
REPORT_DIR=reports

# Validation-only business decision costs. Project assumptions, not universal standards.
FP_COST=10
FN_COST=500
REVIEW_COST=5
REVIEW_LOWER_BOUND=0.30

# API / dashboard
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
MAX_BATCH_SIZE=500
API_BASE_URL=http://localhost:8000

# MLflow is optional; the core ML pipeline continues if logging is unavailable.
ENABLE_MLFLOW=true
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT=fraud-risk-platform

# PostgreSQL is optional for local training/scoring.
ENABLE_DATABASE=false
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=fraud
DATABASE_URL=postgresql+psycopg://fraud:change_me_local@localhost:5432/fraud

# Monitoring
PSI_WARNING=0.20
PSI_CRITICAL=0.25
ENABLE_EVIDENTLY=false
